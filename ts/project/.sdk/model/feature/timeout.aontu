
main: kit: feature: timeout: {

  name: key()
  title: "Timeout"
  description: "Per-request timeout with transport abort"
  version: '0.0.1'
  active: true
  base: 'BASE'
  transport: 'wrap'

  config: {
    options: {
      active: false
      ms: 30000
    }
  }

  # Timeout wraps the transport in init(); it dispatches no pipeline hooks.
  hook: {}
}


main: kit: feature: timeout: config: optspec: {
  # injected clearTimeout
  clearTimer: '`$FUNCTION`'
  # injected setTimeout
  setTimer: '`$FUNCTION`'
}
