
main: kit: feature: validate: {

  name: key()
  title: "Validation"
  description: "Payload validation against the model's own field types"
  version: '0.0.1'
  active: true
  base: 'BASE'
  transport: 'none'

  needs: { schema: true }

  config: {
    options: {
      active: false

      request: true

      response: false

      # Reject keys the model does not declare. The generated specs are
      # `$OPEN`, because apidef records the properties a spec declared and
      # that is not a promise the payload carries nothing else; `strict`
      # drops the `$OPEN` marker at init and closes them.
      strict: false

      mode: 'throw'
    }

    optspec: {
      onInvalid: '`$FUNCTION`'

      mode: ['`$ONE`', ['`$EXACT`', 'throw'], ['`$EXACT`', 'report']]
    }
  }

  hook: {
    PreSpec: active: true

    PreDone: active: true
  }
}
