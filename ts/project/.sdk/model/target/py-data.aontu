# Python Data target — a Python package that *consumes* the sibling Python
# SDK (generated by the `py` target into the same SDK repo) and presents it
# to data analysts working in notebooks (Colab, Jupyter) as pandas
# DataFrames. It is not a language SDK in its own right, so the standard
# per-entity / per-feature / readme / test generation phases are switched
# off via the `phase` map below and Main_py-data emits the whole package.
#
# Requires the `py` target in the same SDK repo (Main_py-data throws when it
# is absent), exactly as go-cli/go-mcp require `go`.

main: kit: target: 'py-data': {

  title: 'Python Data'
  ext: py
  comment: line: "#"
  module: name: '$$name$$'
  srcfeature: false

  # Per-generation-phase activation. Mirrors go-cli/go-mcp: every standard
  # phase is off and Main emits the package. README, agent guides and tests
  # ARE generated — by Main, not by the standard cmps, which assume an
  # SDK-shaped package and would emit wrong content here.
  phase: {
    entity:     { active: false }
    feature:    { active: false }
    readme:     { active: false }
    agentguide: { active: false }
    test:       { active: false }
  }

  deps: &: {
    kind: *'prod' | string
  }

  # pandas is a HARD dependency, not an optional extra: DataFrames are this
  # package's entire reason to exist, and an import guard reading "please
  # install pandas" is worse than declaring it. The sibling py SDK dep is
  # emitted by Main from the model name, so it is not declared here.
  # The base `py` package keeps its single-dependency (requests) footprint.
  deps: {
    'pandas': { active: true, version: '2.0' }
  }
}


# Feature-deps map slot — every target carries this so the same feature can
# specify per-target dep variants.
main: kit: feature: &: target: 'py-data': deps: &: {
  kind: *'prod' | string
}


# Publication: pypi registry (declared, publish pending — git-tag only),
# same posture as the `py` target.
main: kit: target: 'py-data': publish: {
  tag: { active: true }
  registry: {
    state: 'pending'
    active: false
    name: 'pypi'
    url: 'https://pypi.org'
    vault: { recipe: 'pypi', alias: 'pypi' }
  }
}
