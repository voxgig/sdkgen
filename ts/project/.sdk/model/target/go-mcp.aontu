
# An MCP server built on the Go SDK, not an SDK of its own, so every
# standard generation phase is off and Main writes the whole package.

main: kit: target: 'go-mcp': {

  title: 'Go MCP server'
  ext: go
  comment: line: "//"
  module: name: '$$name$$'
  base: 'BASE'
  surface: 'mcp'
  consumes: 'go'

  phase: {
    entity:     { active: false }
    feature:    { active: false }
    readme:     { active: false }
    agentguide: { active: false }
    test:       { active: false }
  }

  # Main writes go.mod, which reaches the Go SDK by a relative replace.
  deps: {}

  tool: write: *false | boolean
}


main: kit: feature: &: target: 'go-mcp': deps: &: {
  kind: *'prod' | string
}


main: kit: target: 'go-mcp': publish: {
  recipe: false
  tag: { via: 'root' }
}
