
# A CLI built on the Go SDK, not an SDK of its own, so every standard
# generation phase is off and Main writes the whole package.

main: kit: target: 'go-cli': {

  title: 'Go CLI'
  ext: go
  comment: line: "//"
  module: name: '$$name$$'
  base: 'BASE'
  surface: 'cli'
  consumes: 'go'

  phase: {
    entity:     { active: false }
    feature:    { active: false }
    readme:     { active: false }
    agentguide: { active: false }
    test:       { active: false }
  }

  deps: {}
}


main: kit: feature: &: target: 'go-cli': deps: &: {
  kind: *'prod' | string
}


main: kit: target: 'go-cli': publish: {
  tag: { via: 'root' }
}
