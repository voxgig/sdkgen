# Makefile for the ProjectName OCaml SDK (generated by @voxgig/sdkgen).
#
# The SDK is dependency-free: it compiles with the stock bytecode compiler
# (ocamlc) — no opam packages, no dune. Four test executables are built:
#   run_sdk_test        — the SDK pipeline + feature suite (Testutil harness)
#   run_omni_smoke      — the vendored omni runner's own failure paths
#   run_struct_corpus   — the shared voxgig/struct JSON corpus
#   run_primary_corpus  — the shared primary-utility JSON corpus
#
# The two corpus suites run on the VENDORED @voxgig/omni engine
# (test/vendor/omni/omni.ml), driven through its native API by the local
# adapter test/omni_resolver.ml. Never edit anything under test/vendor —
# it is resynced from upstream by the sdkgen vendor tool.
#
# Entity modules (sdk_entity_*.ml) and per-entity tests are discovered by
# wildcard; they are mutually independent so their relative order is free.

OCAMLC = ocamlc
INC = -I utility -I . -I test -I test/vendor/omni

# The shared JSON corpus lives in the sibling .sdk workspace.
CORPUS = ../.sdk/test/test.json

RUNTIME = utility/vregex.ml utility/voxgig_struct.ml sdk_json.ml \
  sdk_types.ml sdk_helpers.ml sdk_runtime.ml sdk_features.ml

# The vendored corpus engine plus the adapter that drives it. Order matters:
# the adapter references the vendored module.
OMNI = test/vendor/omni/omni.ml test/omni_resolver.ml

ENTITIES = $(sort $(wildcard sdk_entity_*.ml))

SDK = $(RUNTIME) sdk_config.ml $(ENTITIES) sdk_client.ml sdk_error.ml

ENTITY_TESTS = $(sort $(wildcard test/*_entity_test.ml) $(wildcard test/*_direct_test.ml))

# Doc-example structural gate (present only when the readme phase generated it).
# Wildcard so an absent file is simply skipped, never a missing-target error.
DOC_TESTS = $(sort $(wildcard test/readme_examples_test.ml))

# Fixed test order: harness deps first, generated/behaviour tests, summary last.
SDK_TEST = $(RUNTIME) sdk_config.ml $(ENTITIES) sdk_client.ml sdk_error.ml \
  test/testutil.ml test/harness.ml \
  test/t_pipeline.ml test/t_feature.ml test/custom_utility.ml \
  $(ENTITY_TESTS) $(DOC_TESTS) test/t_main.ml

# The struct corpus needs only the struct library and the corpus engine —
# omni carries its own JSON reader and regex engine, so nothing of the SDK
# runtime is linked here.
CORPUS_SRC = utility/vregex.ml utility/voxgig_struct.ml \
  $(OMNI) test/struct_corpus.ml

# The primary-utility corpus needs the whole SDK, because it drives the SDK's
# own request-shaping utilities — not just the struct library.
PRIMARY_SRC = $(RUNTIME) sdk_config.ml $(ENTITIES) sdk_client.ml sdk_error.ml \
  $(OMNI) test/primary_utility_test.ml

# The runner's own smoke test: an in-memory spec, no fixture file.
SMOKE_SRC = utility/vregex.ml utility/voxgig_struct.ml \
  $(OMNI) test/omni_smoke_test.ml

.PHONY: test test-sdk test-omni test-corpus test-primary build lint clean

test: test-sdk test-omni test-corpus test-primary

test-sdk: run_sdk_test
	./run_sdk_test

test-omni: run_omni_smoke
	./run_omni_smoke

test-corpus: run_struct_corpus
	./run_struct_corpus $(CORPUS)

test-primary: run_primary_corpus
	./run_primary_corpus $(CORPUS)

run_sdk_test: $(SDK_TEST)
	$(OCAMLC) $(INC) $(SDK_TEST) -o run_sdk_test

run_omni_smoke: $(SMOKE_SRC)
	$(OCAMLC) $(INC) $(SMOKE_SRC) -o run_omni_smoke

run_struct_corpus: $(CORPUS_SRC)
	$(OCAMLC) $(INC) $(CORPUS_SRC) -o run_struct_corpus

run_primary_corpus: $(PRIMARY_SRC)
	$(OCAMLC) $(INC) $(PRIMARY_SRC) -o run_primary_corpus

# Type-check the SDK library (a clean compile means it is sound).
build: lint
lint:
	$(OCAMLC) $(INC) -c $(SDK)
	@echo ok

clean:
	rm -f *.cmi *.cmo test/*.cmi test/*.cmo utility/*.cmi utility/*.cmo \
	  test/vendor/omni/*.cmi test/vendor/omni/*.cmo \
	  run_sdk_test run_omni_smoke run_struct_corpus run_primary_corpus a.out
