{
  "name": "podcastdemo-server",
  "version": "1.0.0",
  "description": "Podcast studio example API, serving records and their files, using Fastify",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "server": "npm run build && npm start",
    "validate": "tsx validate.ts",
    "validate:full": "tsx validate.ts --serve",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit/**/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/**/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
